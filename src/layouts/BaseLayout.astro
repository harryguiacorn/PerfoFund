---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PerfoFund — Optimised Performance | AI Performance Intelligence for Capital Markets",
  description = "PerfoFund is an AI-driven performance intelligence platform for investment banks, pension funds, hedge funds and capital markets. Company Shares Selection Strategy (CSSS), real-time risk engine and multi-asset connectivity.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/asset/perfofund-logo.png", Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "PerfoFund Limited",
      url: "https://perfofund.com",
      logo: ogImage,
      email: "info@perfofund.com",
      address: {
        "@type": "PostalAddress",
        streetAddress: "128 City Road",
        addressLocality: "London",
        postalCode: "EC1V 2NX",
        addressCountry: "GB",
      },
    },
    {
      "@type": "WebSite",
      name: "PerfoFund",
      url: "https://perfofund.com",
    },
    {
      "@type": "FinancialProduct",
      name: "Company Shares Selection Strategy (CSSS) Performance Report",
      description:
        "AI-driven company shares selection based on Quick Ratio, Debt to Equity, Operating Profit Margin, ROA, ROE, P/E, P/BV and EPS Growth.",
      provider: { "@type": "Organization", name: "PerfoFund Limited" },
    },
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="PerfoFund Limited" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PerfoFund" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0b1220" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/asset/perfofund-logo.png" />
    <link rel="apple-touch-icon" href="/asset/perfofund-logo.png" />

    <!-- Fonts: preconnect + display=swap for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Cloudflare Web Analytics: add your beacon token here when ready -->
    <!-- <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "YOUR_TOKEN"}'></script> -->
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <slot />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
