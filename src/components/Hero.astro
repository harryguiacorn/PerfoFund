---
const stats = [
  { value: "50+", label: "Years combined experience" },
  { value: "100+", label: "Exchange connectivity" },
  { value: "8", label: "CSSS financial ratios" },
  { value: "0", label: "Management fees" },
];

const audiences = [
  "Investment Banks",
  "Pension Funds",
  "Hedge Fund Groups",
  "Financial Institutions",
  "Capital Markets",
];
---

<section id="top" class="relative overflow-hidden bg-navy-950 text-white">
  <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
  <div class="bg-mesh absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 pt-36 pb-20 sm:px-6 lg:px-8 lg:pt-44 lg:pb-28">
    <div class="grid items-center gap-14 lg:grid-cols-2">
      <!-- Copy -->
      <div class="reveal">
        <p class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-600/10 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-brand-400 uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-400" aria-hidden="true"></span>
          AI Performance Intelligence
        </p>

        <h1 class="mt-6 font-display text-4xl leading-[1.08] font-extrabold tracking-tight text-balance sm:text-5xl lg:text-6xl">
          Optimised Performance for Modern Capital Markets
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
          PerfoFund is an integrated, performance-based AI system for investment banks, pension
          funds, hedge fund groups and financial institutions — connecting capital markets with
          knowledge-driven investors through self-learning pattern recognition and predictive strategy.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="#contact"
            class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lift transition hover:bg-brand-500"
          >
            Get in Touch
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="#product"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur transition hover:border-white/40 hover:bg-white/10"
          >
            Explore the Product
          </a>
        </div>

        <dl class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
          {
            stats.map((stat) => (
              <div>
                <dt class="sr-only">{stat.label}</dt>
                <dd class="font-display text-3xl font-extrabold text-white">{stat.value}</dd>
                <dd class="mt-1 text-xs leading-snug font-medium text-slate-400">{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- CSSS score card -->
      <div class="reveal" style="--reveal-delay: 120ms">
        <div class="relative rounded-3xl border border-white/10 bg-white/[0.06] p-6 shadow-lift backdrop-blur sm:p-8">
          <div class="flex items-center justify-between">
            <p class="font-mono text-xs font-semibold tracking-widest text-slate-400 uppercase">CSSS Performance Report</p>
            <span class="rounded-full bg-emerald-500/15 px-2.5 py-1 text-xs font-semibold text-emerald-300">Live</span>
          </div>

          <div class="mt-6 flex items-end gap-3">
            <p class="font-display text-6xl font-extrabold tracking-tight">8.4</p>
            <p class="pb-2 text-sm text-slate-400">/ 10 composite score</p>
          </div>

          <!-- Mini bar chart -->
          <div class="mt-6 space-y-3" role="img" aria-label="CSSS ratio scores: ROE 8.8, ROA 8.1, EPS Growth 8.6, P/E 7.9, Debt to Equity 8.2">
            {
              [
                { label: "ROE", value: 88 },
                { label: "EPS Growth", value: 86 },
                { label: "Debt / Equity", value: 82 },
                { label: "ROA", value: 81 },
                { label: "P/E", value: 79 },
              ].map((row) => (
                <div class="flex items-center gap-3">
                  <span class="w-24 shrink-0 font-mono text-[11px] font-medium text-slate-400">{row.label}</span>
                  <div class="h-2 flex-1 overflow-hidden rounded-full bg-white/10">
                    <div class="h-full rounded-full bg-gradient-to-r from-brand-600 to-accent-400" style={`width: ${row.value}%`}></div>
                  </div>
                  <span class="w-8 text-right font-mono text-[11px] font-semibold text-slate-300">{(row.value / 10).toFixed(1)}</span>
                </div>
              ))
            }
          </div>

          <div class="mt-7 flex flex-wrap gap-2">
            {
              audiences.map((a) => (
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-slate-300">{a}</span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
