---
import SectionHeading from "./SectionHeading.astro";

const pillars = [
  { title: "Market Risk", text: "Real-time exposure across multi-lateral markets." },
  { title: "Credit Risk", text: "Counterparty and issuer quality assessment." },
  { title: "Counterparty Risk", text: "Settlement and exposure monitoring." },
  { title: "Common Factor Risk", text: "Cross-asset factor correlation analysis." },
  { title: "Regulatory Measurement", text: "Reporting aligned to regulatory requirements." },
  { title: "Hedge Fund Transparency", text: "Clear, auditable performance reporting." },
  { title: "Performance Analytics", text: "Event-driven performance attribution." },
  { title: "Wealth Management Analytics", text: "Portfolio-level insight for advisers." },
];

const steps = [
  {
    title: "Analyse order flow",
    text: "The proprietary risk engine analyses order flow in real time across all segments of cross-platform capital markets.",
  },
  {
    title: "Determine hedging",
    text: "Optimal hedging strategies are determined from predetermined risk parameters — not guesswork.",
  },
  {
    title: "Validate continuously",
    text: "Historical order flow is analysed to confirm current hedging strategies remain optimal.",
  },
  {
    title: "White-label platform",
    text: "The engine can white-label a proprietary trading platform with embedded risk management, CRM and back-office technology.",
  },
];
---

<section id="riskmanagement" class="scroll-mt-24 bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Risk Management"
      title="A proprietary risk engine for high-volume performance reporting"
      description="PerfoFund integrates risk engine technology into high-volume performance reporting platforms. The module is proprietary and applicable to all segments of cross-platform capital markets."
    />

    <!-- Risk pillars (replaces legacy puzzle diagram) -->
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p, i) => (
          <li class="reveal rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-card transition hover:-translate-y-0.5 hover:shadow-lift" style={`--reveal-delay: ${(i % 4) * 60}ms`}>
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-navy-900 text-white">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <h3 class="mt-3 font-display text-base font-bold text-navy-900">{p.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-slate-600">{p.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-14 grid gap-10 lg:grid-cols-2">
      <!-- Risk / return visual (replaces legacy bubble chart) -->
      <div class="reveal rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-card sm:p-8">
        <div class="flex items-center justify-between">
          <h3 class="font-display text-base font-bold text-navy-900">Risk vs. Returns — positioning</h3>
          <span class="font-mono text-[11px] font-medium text-slate-500">ILLUSTRATIVE</span>
        </div>
        <svg viewBox="0 0 520 300" class="mt-5 w-full" role="img" aria-label="Illustrative risk versus returns chart. Aggressive growth stocks sit at high risk and high return, moving over time toward higher returns.">
          <!-- axes -->
          <line x1="60" y1="260" x2="500" y2="260" stroke="#cbd5e1" stroke-width="2"/>
          <line x1="60" y1="260" x2="60" y2="20" stroke="#cbd5e1" stroke-width="2"/>
          <text x="280" y="290" text-anchor="middle" font-size="12" font-weight="700" fill="#475569" letter-spacing="2">RISK →</text>
          <text x="18" y="140" text-anchor="middle" font-size="12" font-weight="700" fill="#475569" letter-spacing="2" transform="rotate(-90 18 140)">RETURNS →</text>
          <!-- efficient frontier -->
          <path d="M80 240 Q 220 200 320 130 T 470 60" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-dasharray="6 5"/>
          <!-- points -->
          <g font-size="11" font-weight="600" fill="#334155">
            <circle cx="90" cy="235" r="7" fill="#94a3b8"/><text x="90" y="220" text-anchor="middle">T-Bills</text>
            <circle cx="160" cy="205" r="7" fill="#64748b"/><text x="160" y="190" text-anchor="middle">Corp. Bond</text>
            <circle cx="230" cy="175" r="7" fill="#3b82f6"/><text x="230" y="160" text-anchor="middle">Real Estate</text>
            <circle cx="295" cy="140" r="7" fill="#2563eb"/><text x="295" y="125" text-anchor="middle">Mutual Funds</text>
            <circle cx="360" cy="105" r="7" fill="#1d4ed8"/><text x="360" y="90" text-anchor="middle">Hedge Funds</text>
            <circle cx="420" cy="75" r="7" fill="#0ea5e9"/><text x="420" y="60" text-anchor="middle">VC / PE</text>
            <circle cx="465" cy="50" r="9" fill="#f59e0b"/><text x="465" y="35" text-anchor="middle">Aggressive Growth</text>
          </g>
          <text x="465" y="95" text-anchor="middle" font-size="10" fill="#92400e" font-style="italic">over time →</text>
        </svg>
        <p class="mt-3 text-xs leading-relaxed text-slate-500">
          CSSS targets aggressive growth profiles with disciplined risk parameters — the frontier
          shifts over time as strategies compound.
        </p>
      </div>

      <!-- Engine steps -->
      <ol class="reveal space-y-4" style="--reveal-delay: 120ms">
        {
          steps.map((s, i) => (
            <li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-card">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600 font-display text-sm font-extrabold text-white">
                {i + 1}
              </span>
              <span>
                <span class="block font-display text-base font-bold text-navy-900">{s.title}</span>
                <span class="mt-1 block text-sm leading-relaxed text-slate-600">{s.text}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
