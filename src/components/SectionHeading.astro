---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  dark?: boolean;
  align?: "left" | "center";
}

const { eyebrow, title, description, dark = false, align = "left" } = Astro.props;
const alignClass = align === "center" ? "mx-auto text-center" : "";
---

<div class={`reveal max-w-2xl ${alignClass}`}>
  <p class={`font-mono text-xs font-semibold tracking-[0.2em] uppercase ${dark ? "text-brand-400" : "text-brand-600"}`}>
    {eyebrow}
  </p>
  <h2 class={`mt-3 font-display text-3xl font-extrabold tracking-tight text-balance sm:text-4xl ${dark ? "text-white" : "text-navy-900"}`}>
    {title}
  </h2>
  {description && (
    <p class={`mt-4 text-lg leading-relaxed ${dark ? "text-slate-300" : "text-slate-600"}`}>{description}</p>
  )}
</div>
