---
const links = [
  { href: "#introduction", label: "Introduction" },
  { href: "#product", label: "Product" },
  { href: "#riskmanagement", label: "Risk Management" },
  { href: "#disclaimer", label: "Disclaimer" },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-all duration-300"
>
  <nav class="mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="Primary">
    <a href="#top" class="flex items-center gap-3" aria-label="PerfoFund — home">
      <!-- White logo variant: navbar sits on dark navy, so the blue original
           has no contrast. Blue original is kept for light backgrounds. -->
      <picture>
        <source srcset="/asset/perfofund-logo-white.webp" type="image/webp" />
        <img
          src="/asset/perfofund-logo-white.png"
          alt="PerfoFund"
          width="160"
          height="51"
          class="h-10 w-auto drop-shadow-[0_1px_8px_rgb(59_130_246/0.35)]"
          fetchpriority="high"
        />
      </picture>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link
              class="rounded-full px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-white/10 hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden md:block">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-card transition hover:bg-brand-700 hover:shadow-lift"
      >
        Get in Touch
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <button
      id="menu-button"
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-slate-200 hover:bg-white/10 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-white/10 bg-navy-900/95 backdrop-blur md:hidden">
    <ul class="space-y-1 px-4 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link
              class="block rounded-lg px-4 py-3 text-base font-medium text-slate-200 hover:bg-white/10 hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href="#contact"
          class="block rounded-lg bg-brand-600 px-4 py-3 text-center text-base font-semibold text-white hover:bg-brand-700"
        >
          Get in Touch
        </a>
      </li>
    </ul>
  </div>
</header>
