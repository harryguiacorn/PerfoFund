---
import SectionHeading from "./SectionHeading.astro";

const disciplines = [
  { title: "Mathematicians", text: "Rigorous modelling of performance, risk and pricing." },
  { title: "Scientists", text: "Self-learning systems and pattern recognition research." },
  { title: "Engineers", text: "Low-latency platforms, APIs and secure infrastructure." },
  { title: "Business Builders", text: "50+ years of combined high-tech business development." },
];
---

<section id="whoweare" class="scroll-mt-24 bg-slate-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal order-2 lg:order-1">
        <figure class="overflow-hidden rounded-3xl shadow-lift">
          <img
            src="/asset/team.webp"
            alt="PerfoFund team collaborating around a table with laptops and documents"
            width="1600"
            height="1066"
            loading="lazy"
            decoding="async"
            class="aspect-[3/2] w-full object-cover"
          />
        </figure>
        <figcaption class="mt-3 text-center text-xs text-slate-500">
          A global team of mathematicians, scientists, engineers and business builders.
        </figcaption>
      </div>

      <div class="order-1 lg:order-2">
        <SectionHeading eyebrow="Who We Are" title="Built by a global, interdisciplinary team" />
        <p class="reveal mt-5 leading-relaxed text-slate-600">
          We are a group of enthusiastic mathematicians, scientists, engineers and business-oriented
          individuals who have joined together from different regions of the world to develop and
          launch the PerfoFund solution platform. The group offers over 50+ years of combined
          high-tech business development experience to deliver this unique project — and we are
          constantly looking to expand our team to achieve higher goals for our future projects.
        </p>

        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            disciplines.map((d, i) => (
              <li class="reveal rounded-2xl border border-slate-200 bg-white p-5 shadow-card" style={`--reveal-delay: ${i * 60}ms`}>
                <h3 class="font-display text-base font-bold text-navy-900">{d.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{d.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
